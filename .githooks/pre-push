#!/usr/bin/env bash
# pre-push hook: second secrets net at the last exit before public.
#
# The pre-commit gate scans staged changes, but commits can dodge it:
# --no-verify, commits created through APIs (GraphQL createCommitOnBranch)
# or other tools. This scans EVERY local commit not yet on any remote with
# the full ruleset (gitleaks defaults + custom tripwires) and blocks the
# push if anything is found. History is the attack surface: a secret in a
# pushed commit stays fetchable by SHA even after a force-push (Phase 20.1
# hiccup log, entry 13).
#
# Install: git config core.hooksPath .githooks   (already the global default)
# Bypass:  git push --no-verify   (do not)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
GL_CONFIG="$REPO_ROOT/.gitleaks.local.toml"
if [ ! -f "$GL_CONFIG" ]; then
  echo "BLOCKED. $GL_CONFIG is missing. It holds the literal tripwires that must not live in the public config; restore it from the private store before committing."
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: BLOCKED. gitleaks not installed (brew install gitleaks)."
  echo "Refusing to push unscanned commits to a public repo."
  exit 1
fi

if ! gitleaks git --redact --config "$GL_CONFIG" \
    --log-opts "--branches --not --remotes" >/dev/null 2>&1; then
  echo "pre-push: BLOCKED. gitleaks found a secret or tripwire in unpushed commits:"
  gitleaks git --redact --config "$GL_CONFIG" \
    --log-opts "--branches --not --remotes" 2>&1 \
    | grep -E "RuleID:|File:|Commit:|Line:" | head -16 || true
  echo "The finding is in COMMIT HISTORY, not just the working tree:"
  echo "amend or rewrite the offending commit before pushing."
  exit 1
fi

echo "pre-push: gitleaks clean on all unpushed commits."

# Second gate: fail-closed authorship. Scoped to exactly the commits being
# pushed (read from stdin), so a stale local-only branch cannot false-block an
# unrelated push. Same rule the authorship-guard workflow enforces on the
# pipeline, so a --no-verify commit is still stopped at the merge.
ZERO=0000000000000000000000000000000000000000
authorship_fail=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$ZERO" ] && continue            # branch deletion: nothing to check
  if [ "$rsha" = "$ZERO" ]; then
    bash "$REPO_ROOT/scripts/repo/check_authorship.sh" "$lsha" --not --remotes || authorship_fail=1
  else
    bash "$REPO_ROOT/scripts/repo/check_authorship.sh" "$rsha..$lsha" || authorship_fail=1
  fi
done
if [ "$authorship_fail" -ne 0 ]; then
  echo "pre-push: BLOCKED by the authorship gate above."
  exit 1
fi

exit 0
