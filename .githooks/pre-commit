#!/usr/bin/env bash
# pre-commit hook: keeps canonical artifacts in sync with source.
#
# Two jobs:
#
# 1. AI-tells sweep on staged markdown
#    BLOCKS commits with em dashes, en dashes, or double-hyphen prose.
#    WARNS on AI-tell phrases and "not X. Y." juxtaposition.
#
# 2. Canonical metric rebuild
#    When staged changes touch docs/grc/, terraform/, detections/,
#    .github/workflows/, or COREDIRECTIVE_ENGINE/docker-compose.yaml,
#    rerun scripts/build_metrics.py and the GTA build_manifest.py.
#    Stage the regenerated metrics.yaml + REPO_MAP.yaml so they ride
#    into the same commit. Metrics drift is impossible by construction.
#
# Install: git config core.hooksPath .githooks
# Bypass:  git commit --no-verify  (NOT recommended)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
GTA_DIR="${HOME}/.claude/skills/gta"
SWEEP_SCRIPT="${GTA_DIR}/scripts/sweep_ai_tells.py"
MANIFEST_SCRIPT="${GTA_DIR}/scripts/build_manifest.py"
METRICS_SCRIPT="${REPO_ROOT}/scripts/build_metrics.py"

STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM || true)
STAGED_MD=$(echo "$STAGED_ALL" | grep -E '\.md$' || true)

# Patterns that should trigger metrics rebuild.
METRIC_SOURCES_RE='^(docs/grc/|terraform/|detections/|\.github/workflows/|COREDIRECTIVE_ENGINE/docker-compose\.ya?ml$)'
STAGED_SOURCE=$(echo "$STAGED_ALL" | grep -E "$METRIC_SOURCES_RE" || true)

# ---------------------------------------------------------------------------
# Job 0: secrets + sanitization gate (gitleaks: default rules + tripwires)
# Runs FIRST and blocks. Added 2026-08-31 (Phase 20.1) after CI caught
# sanitization misses only post-push, when a public repo branch is already
# public. Note .gitleaks.toml needs [extend] useDefault = true: a custom
# config REPLACES the built-in secret rules without it, which means real
# API keys were passing unscanned. Fail-closed: no scanner, no commit.
# ---------------------------------------------------------------------------

if [ -n "$STAGED_ALL" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --pre-commit --staged --redact --config "$REPO_ROOT/.gitleaks.toml" >/dev/null 2>&1; then
      echo "pre-commit: BLOCKED. gitleaks found a secret or sanitization tripwire in staged changes:"
      gitleaks git --pre-commit --staged --redact --config "$REPO_ROOT/.gitleaks.toml" 2>&1 \
        | grep -E "RuleID:|File:|Line:" | head -12 || true
      echo "Fix the content (do not allowlist around it), restage, retry."
      exit 1
    fi
    echo "pre-commit: gitleaks clean."
  else
    echo "pre-commit: BLOCKED. gitleaks not installed (brew install gitleaks)."
    echo "Refusing to commit unscanned to a public repo."
    exit 1
  fi
fi

# ---------------------------------------------------------------------------
# Job 1: AI-tells sweep
# ---------------------------------------------------------------------------

if [ -n "$STAGED_MD" ] && [ -x "$SWEEP_SCRIPT" ]; then
  echo "pre-commit: AI-tells sweep on staged markdown..."
  OUTPUT=$(python3 "$SWEEP_SCRIPT" $STAGED_MD 2>&1) || true

  if echo "$OUTPUT" | grep -qE 'em=[1-9]|en=[1-9]|dashes=[1-9]'; then
    echo
    echo "pre-commit: BLOCKED. Em dashes, en dashes, or double-hyphens in staged files."
    echo
    echo "$OUTPUT" | grep -E 'em=|en=|dashes='
    echo
    echo "Auto-fix:"
    echo "  python3 $SWEEP_SCRIPT --apply $STAGED_MD"
    echo "  git add $STAGED_MD"
    echo "  git commit"
    exit 1
  fi

  if echo "$OUTPUT" | grep -qE 'ai_tells=|juxt='; then
    echo
    echo "pre-commit: WARNING. AI-tell phrases or juxtaposition found."
    echo "$OUTPUT" | grep -E 'ai_tells=|juxt='
    echo "Review with: python3 $SWEEP_SCRIPT -v $STAGED_MD"
    echo "Proceeding with commit. Fix later if review confirms violation."
  fi
elif [ -n "$STAGED_MD" ] && [ ! -x "$SWEEP_SCRIPT" ]; then
  echo "pre-commit: sweep script missing at $SWEEP_SCRIPT, skipping AI-tells job"
fi

# ---------------------------------------------------------------------------
# Job 2: canonical metric rebuild
# ---------------------------------------------------------------------------

if [ -n "$STAGED_SOURCE" ]; then
  echo "pre-commit: source files touched, rebuilding metrics.yaml..."

  if [ -x "$METRICS_SCRIPT" ]; then
    if python3 "$METRICS_SCRIPT" >/dev/null; then
      if ! git diff --quiet -- metrics.yaml 2>/dev/null; then
        git add metrics.yaml
        echo "pre-commit: metrics.yaml rebuilt and staged."
      else
        echo "pre-commit: metrics.yaml unchanged."
      fi
    else
      echo "pre-commit: BLOCKED. build_metrics.py failed. Fix and retry."
      exit 1
    fi
  else
    echo "pre-commit: METRICS_SCRIPT missing at $METRICS_SCRIPT, skipping metrics rebuild"
  fi

  if [ -x "$MANIFEST_SCRIPT" ]; then
    echo "pre-commit: rebuilding REPO_MAP.yaml..."
    if python3 "$MANIFEST_SCRIPT" --repo-root "$REPO_ROOT" >/dev/null; then
      if ! git diff --quiet -- REPO_MAP.yaml 2>/dev/null; then
        git add REPO_MAP.yaml
        echo "pre-commit: REPO_MAP.yaml rebuilt and staged."
      else
        echo "pre-commit: REPO_MAP.yaml unchanged."
      fi
    else
      echo "pre-commit: WARNING. build_manifest.py failed. Proceeding without REPO_MAP refresh."
    fi
  fi
fi

echo "pre-commit: done."
exit 0
