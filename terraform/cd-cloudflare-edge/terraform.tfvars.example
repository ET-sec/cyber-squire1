# Copy to terraform.tfvars (gitignored) and fill in.

cf_account_id           = "your-cloudflare-account-id"
cf_zone_id              = "your-zone-id"
domain                  = "example.com"
admin_emails            = ["you@example.com"]

# Path prefix of the n8n Telegram Trigger webhook: /webhook/<trigger-id>
# Read it from n8n (Telegram Trigger node, Production URL) or from the
# Telegram Bot API getWebhookInfo response.
telegram_webhook_prefix = "/webhook/replace-me"

# Defaults are fine for a fresh replication:
# admin_subdomains   = ["n8n", "langfuse", "squire"]
# telegram_ip_ranges = [...]  # default is the full list from core.telegram.org/resources/cidr.txt
# home_country       = "US"
