#!/bin/bash
# CoreDirective Engine -- Cloud-Init Bootstrap Script
# Rendered by Terraform templatefile() for disaster recovery
# Provisions a fresh Ubuntu 24.04 droplet into a running CoreDirective Engine
#
# Usage (after rendering):
#   1. Create new droplet (or use as user_data for NEW droplet only)
#   2. SSH in and run: doppler run -- docker compose up -d
#
# WARNING: Do NOT attach this as user_data to an EXISTING droplet.
#          user_data is ForceNew -- Terraform would DESTROY and recreate it.

set -euo pipefail

echo "=== CoreDirective Engine Bootstrap ==="
echo "Started: $(date -u +%Y-%m-%dT%H:%M:%SZ)"

# ==========================================
# 1. System Updates
# ==========================================
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get upgrade -y

# ==========================================
# 2. Install Docker
# ==========================================
if ! command -v docker &>/dev/null; then
  echo "Installing Docker..."
  curl -fsSL https://get.docker.com | sh
  systemctl enable docker
  systemctl start docker
  echo "Docker installed: $(docker --version)"
else
  echo "Docker already installed: $(docker --version)"
fi

# ==========================================
# 3. Install Doppler CLI (secrets manager)
# ==========================================
if ! command -v doppler &>/dev/null; then
  echo "Installing Doppler CLI..."
  apt-get install -y apt-transport-https ca-certificates curl gnupg
  curl -sLf --retry 3 --tlsv1.2 --proto "=https" \
    "https://packages.doppler.com/public/cli/gpg.DE2A7741A397C129.key" \
    | gpg --dearmor -o /usr/share/keyrings/doppler-archive-keyring.gpg
  echo "deb [signed-by=/usr/share/keyrings/doppler-archive-keyring.gpg] https://packages.doppler.com/public/cli/deb/debian any-version main" \
    | tee /etc/apt/sources.list.d/doppler-cli.list
  apt-get update -y
  apt-get install -y doppler
  echo "Doppler installed: $(doppler --version)"
else
  echo "Doppler already installed: $(doppler --version)"
fi

# ==========================================
# 4. Install common utilities
# ==========================================
apt-get install -y \
  jq \
  htop \
  ncdu \
  ffmpeg \
  unzip \
  fail2ban

# Enable fail2ban
systemctl enable fail2ban
systemctl start fail2ban

# ==========================================
# 5. Create directory structure
# ==========================================
echo "Creating CoreDirective Engine directory structure..."
mkdir -p /root/COREDIRECTIVE_ENGINE/{CD_VOL_POSTGRES,CD_VOL_N8N,CD_VOL_OLLAMA,CD_VOL_WHISPER,CD_VOL_VAULT/{config,data,logs},CD_BACKUPS}

# Set ownership for services that run as non-root
chown -R 1000:1000 /root/COREDIRECTIVE_ENGINE/CD_VOL_N8N
chown -R 999:999 /root/COREDIRECTIVE_ENGINE/CD_VOL_POSTGRES

# ==========================================
# 6. Write Docker Compose file
# ==========================================
echo "Writing docker-compose.yaml..."
cat > /root/COREDIRECTIVE_ENGINE/docker-compose.yaml << 'COMPOSE_EOF'
${docker_compose_content}
COMPOSE_EOF

echo "Docker Compose file written."

# ==========================================
# 7. Configure firewall (UFW)
# ==========================================
echo "Configuring UFW firewall..."
ufw --force reset
ufw default deny incoming
ufw default allow outgoing
ufw allow 22/tcp    # SSH
ufw allow 80/tcp    # HTTP (Cloudflare tunnel)
ufw allow 443/tcp   # HTTPS (Cloudflare tunnel)
ufw --force enable
echo "UFW enabled."

# ==========================================
# 8. Post-bootstrap instructions
# ==========================================
echo ""
echo "=== Bootstrap Complete ==="
echo "Completed: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo ""
echo "Next steps:"
echo "  1. Configure Doppler: doppler login && doppler setup"
echo "  2. Start the stack: cd /root/COREDIRECTIVE_ENGINE && doppler run -- docker compose up -d"
echo "  3. Verify services: docker ps"
echo "  4. Check n8n: curl -s http://localhost:5678/healthz"
echo ""
