{
  "name": "Gumroad Solvency Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "schedule-daily",
      "name": "Daily 8AM UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 700]
    },
    {
      "parameters": {
        "url": "https://api.gumroad.com/v2/sales",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gumroadApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "after",
              "value": "={{ $now.minus({hours: 24}).toISO() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "fetch-recent-sales",
      "name": "Fetch Last 24h Sales",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 700],
      "credentials": {
        "gumroadApi": {
          "id": "XQXgMQ3pnZBEJdsQ",
          "name": "Gumroad"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const sales = $input.item.json.sales || [];\n\nif (sales.length === 0) {\n  return [{ json: { no_sales: true, message: 'No new sales in last 24h' } }];\n}\n\nconst processed = [];\nfor (const sale of sales) {\n  const amount = parseFloat(sale.price) / 100;\n  const fee = parseFloat(sale.gumroad_fee) / 100;\n  const net = amount - fee;\n  \n  processed.push({\n    sale_id: sale.id,\n    product_name: sale.product_name,\n    customer_email: sale.email,\n    customer_name: sale.full_name || 'Customer',\n    sale_timestamp: sale.created_at,\n    gross_amount: amount,\n    fees: fee,\n    net_amount: net,\n    debt_allocation: +(net * 0.60).toFixed(2),\n    reinvest_allocation: +(net * 0.30).toFixed(2),\n    reserve_allocation: +(net * 0.10).toFixed(2),\n    currency: 'USD'\n  });\n}\n\nreturn processed.map(p => ({ json: p }));"
      },
      "id": "process-sales",
      "name": "Process Sales & Allocate 60/30/10",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 700]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.no_sales }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "check-sales",
      "name": "Any Sales?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 700]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { message: 'No sales yesterday. Keep pushing.' } }];"
      },
      "id": "no-sales",
      "name": "No Sales",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 800]
    },
    {
      "parameters": {
        "model": "qwen3:8b",
        "messages": {
          "values": [
            {
              "content": "=Generate a brief, warm thank you message (2-3 sentences) for {{ $json.customer_name }} who purchased {{ $json.product_name }}. Mention it supports cybersecurity education."
            }
          ]
        },
        "options": { "temperature": 0.8 }
      },
      "id": "generate-thank-you",
      "name": "Generate Thank You",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [1120, 600],
      "credentials": {
        "ollamaApi": {
          "id": "DDKhERoRj4skKmDw",
          "name": "Ollama"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $('Process Sales & Allocate 60/30/10').item.json.customer_email }}",
        "subject": "=Thank you for {{ $('Process Sales & Allocate 60/30/10').item.json.product_name }}!",
        "emailType": "text",
        "message": "={{ $json.response }}",
        "options": {}
      },
      "id": "send-thank-you",
      "name": "Send Thank You Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [1340, 600],
      "credentials": {
        "gmailOAuth2": {
          "id": "beShgZR7p3A8I3zE",
          "name": "Gmail"
        }
      }
    },
    {
      "parameters": {
        "chatId": "6691629392",
        "text": "=💰 **Gumroad Sale!**\n\n{{ $('Process Sales & Allocate 60/30/10').item.json.product_name }}\nNet: ${{ $('Process Sales & Allocate 60/30/10').item.json.net_amount }}\n\n📊 60/30/10 Split:\n• Debt: ${{ $('Process Sales & Allocate 60/30/10').item.json.debt_allocation }}\n• Reinvest: ${{ $('Process Sales & Allocate 60/30/10').item.json.reinvest_allocation }}\n• Reserve: ${{ $('Process Sales & Allocate 60/30/10').item.json.reserve_allocation }}",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "notify-telegram",
      "name": "Notify Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1560, 600],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-main",
          "name": "Telegram"
        }
      }
    }
  ],
  "connections": {
    "Daily 8AM UTC": { "main": [[{ "node": "Fetch Last 24h Sales", "type": "main", "index": 0 }]] },
    "Fetch Last 24h Sales": { "main": [[{ "node": "Process Sales & Allocate 60/30/10", "type": "main", "index": 0 }]] },
    "Process Sales & Allocate 60/30/10": { "main": [[{ "node": "Any Sales?", "type": "main", "index": 0 }]] },
    "Any Sales?": {
      "main": [
        [{ "node": "No Sales", "type": "main", "index": 0 }],
        [{ "node": "Generate Thank You", "type": "main", "index": 0 }]
      ]
    },
    "Generate Thank You": { "main": [[{ "node": "Send Thank You Email", "type": "main", "index": 0 }]] },
    "Send Thank You Email": { "main": [[{ "node": "Notify Telegram", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "notes": "Daily Gumroad sales check. 60/30/10 allocation (debt/reinvest/reserve). AI thank-you via Qwen3, sends via Gmail, notifies Telegram." }
}
