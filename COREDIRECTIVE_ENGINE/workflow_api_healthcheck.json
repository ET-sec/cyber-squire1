{
  "name": "CoreDirective API Health Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "start-node",
      "name": "Daily 6AM UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "model": "qwen3:8b",
        "messages": {
          "values": [
            {
              "content": "Reply with OK"
            }
          ]
        },
        "options": {}
      },
      "id": "ollama-check",
      "name": "Test Ollama/Qwen3",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [460, 120],
      "credentials": {
        "ollamaApi": {
          "id": "DDKhERoRj4skKmDw",
          "name": "Ollama"
        }
      }
    },
    {
      "parameters": {
        "owner": "anthropics",
        "repository": "anthropic-sdk-python",
        "operation": "get"
      },
      "id": "github-check",
      "name": "Test GitHub API",
      "type": "n8n-nodes-base.github",
      "typeVersion": 1,
      "position": [460, 240],
      "credentials": {
        "githubApi": {
          "id": "2CynRBifhrbnxeLe",
          "name": "GitHub"
        }
      }
    },
    {
      "parameters": {
        "operation": "search",
        "text": "health check"
      },
      "id": "notion-check",
      "name": "Test Notion API",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [460, 360],
      "credentials": {
        "notionApi": {
          "id": "NPNXZ45GxiU7SoaS",
          "name": "Notion"
        }
      }
    },
    {
      "parameters": {
        "url": "https://api.gumroad.com/v2/user",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gumroadApi",
        "options": {}
      },
      "id": "gumroad-check",
      "name": "Test Gumroad API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 480],
      "credentials": {
        "gumroadApi": {
          "id": "XQXgMQ3pnZBEJdsQ",
          "name": "Gumroad"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "etigoue@tigouetheory.com",
        "subject": "=CoreDirective Health Check {{ $now.format('yyyy-MM-dd') }}",
        "emailType": "text",
        "message": "Test ping",
        "options": {}
      },
      "id": "gmail-check",
      "name": "Test Gmail OAuth",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [460, 720],
      "credentials": {
        "gmailOAuth2": {
          "id": "beShgZR7p3A8I3zE",
          "name": "Gmail"
        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "jsCode": "const checks = ['Ollama/Qwen3', 'GitHub', 'Notion', 'Gumroad'];\nconst results = [];\nconst allItems = $input.all();\n\nfor (let i = 0; i < allItems.length; i++) {\n  const item = allItems[i];\n  const hasError = item.json.error || item.json.statusCode >= 400;\n  results.push({\n    service: checks[i] || `Service ${i}`,\n    status: hasError ? 'FAILED' : 'PASS',\n    timestamp: new Date().toISOString()\n  });\n}\n\nconst failures = results.filter(r => r.status === 'FAILED');\nconst summary = results.map(r => `${r.status === 'PASS' ? '✅' : '❌'} ${r.service}`).join('\\n');\n\nreturn [{\n  json: {\n    summary,\n    failures: failures.map(f => f.service),\n    hasFailures: failures.length > 0,\n    total: results.length,\n    passed: results.length - failures.length\n  }\n}];"
      },
      "id": "aggregate-results",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 360]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "leftValue": "={{ $json.hasFailures }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "check-failures",
      "name": "Any Failures?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 360]
    },
    {
      "parameters": {
        "chatId": "6691629392",
        "text": "=🚨 **API Health Alert**\n\n{{ $json.summary }}\n\n{{ $json.failures.length }} service(s) down. Check n8n executions.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "id": "alert-telegram",
      "name": "Alert via Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1120, 260],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-main",
          "name": "Telegram"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { message: `✅ All ${$json.total} APIs healthy at ${new Date().toISOString()}` } }];"
      },
      "id": "success-log",
      "name": "All Healthy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 460]
    }
  ],
  "connections": {
    "Daily 6AM UTC": {
      "main": [[
        { "node": "Test Ollama/Qwen3", "type": "main", "index": 0 },
        { "node": "Test GitHub API", "type": "main", "index": 0 },
        { "node": "Test Notion API", "type": "main", "index": 0 },
        { "node": "Test Gumroad API", "type": "main", "index": 0 }
      ]]
    },
    "Test Ollama/Qwen3": { "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]] },
    "Test GitHub API": { "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]] },
    "Test Notion API": { "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]] },
    "Test Gumroad API": { "main": [[{ "node": "Aggregate Results", "type": "main", "index": 0 }]] },
    "Aggregate Results": { "main": [[{ "node": "Any Failures?", "type": "main", "index": 0 }]] },
    "Any Failures?": {
      "main": [
        [{ "node": "Alert via Telegram", "type": "main", "index": 0 }],
        [{ "node": "All Healthy", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "meta": { "notes": "Daily health check: Tests Ollama, GitHub, Notion, Gumroad APIs. Alerts via Telegram on failure." }
}
